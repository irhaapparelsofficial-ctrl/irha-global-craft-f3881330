# Long-cache hashed build assets (Vite emits content-hashed filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Generated responsive website images. Their paths change when the source object
# changes, so browsers and Cloudflare can keep them for one year safely.
/thumbnails/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable
/responsive/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

# Images
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=2592000

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# CSS / JS in public/
/*.css
  Cache-Control: public, max-age=2592000
/*.js
  Cache-Control: public, max-age=2592000
/agent-webmcp.js
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# Catalog PDFs
/catalogs/*
  Cache-Control: public, max-age=2592000

# Deployment identity — never serve a stale release marker
/build.json
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/release.txt
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# Search and AI crawler controls — always expose the current deployment
/robots.txt
  Cache-Control: no-store, no-transform, max-age=0, must-revalidate
  CDN-Cache-Control: no-store, no-transform
/sitemap.xml
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

# Agent and API discovery
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/.well-known/openid-configuration
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/skills/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/docs/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *
/openapi/*
  Content-Type: application/vnd.oai.openapi+json;version=3.1
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

# HTML — always revalidate so deploys go live immediately
/
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/*.html
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# Security and discovery headers (safe defaults for the public SPA and owner backend)
/*
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/mcp/server-card.json>; rel="service-desc", </.well-known/agent-skills/index.json>; rel="service-meta", </auth.md>; rel="authorization"
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; script-src-elem 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://*.cloudflareinsights.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: tools=(self), geolocation=(), microphone=(), camera=(), payment=(), usb=()

# Private application routes must never enter search indexes.
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
/auth
  X-Robots-Tag: noindex, nofollow, noarchive
/auth/*
  X-Robots-Tag: noindex, nofollow, noarchive
/dashboard
  X-Robots-Tag: noindex, nofollow, noarchive
/login
  X-Robots-Tag: noindex, nofollow, noarchive
/log-in
  X-Robots-Tag: noindex, nofollow, noarchive
/signin
  X-Robots-Tag: noindex, nofollow, noarchive
/sign-in
  X-Robots-Tag: noindex, nofollow, noarchive
/seo-indexing
  X-Robots-Tag: noindex, nofollow, noarchive
